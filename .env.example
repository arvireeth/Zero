VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerodotemail"

# Change this to a random string, use `openssl rand -hex 32` to generate a 32 character string
BETTER_AUTH_SECRET=my-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

COOKIE_DOMAIN="localhost"

# Change to your project's client ID and secret, these work with localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstash/Local Redis Instance
REDIS_URL="http://localhost:8079"
REDIS_TOKEN="upstash-local-token"

# Resend API Key
RESEND_API_KEY=

# OpenRouter API key (all AI features). Free models require a free OpenRouter account/key.
OPENROUTER_API_KEY=

# Free-first AI: the free router chooses a compatible free model. Paid models are blocked
# unless you explicitly set ALLOW_PAID_AI=true. Free models may be rate-limited/unavailable.
ALLOW_PAID_AI=false
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MINI_MODEL=openrouter/free
OPENROUTER_SEARCH_MODEL=openrouter/free

# Optional second provider. Only used when explicitly enabled and OpenRouter fails.
# Google free-tier prompts may be used to improve Google's products; enable only if comfortable
# sending the relevant email content to Google. For a hard no-charge setup, use an AI Studio
# project without billing enabled so quota exhaustion fails instead of switching to paid usage.
GOOGLE_GENERATIVE_AI_API_KEY=
ALLOW_GEMINI_FALLBACK=false
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

#AI PROMPT
AI_SYSTEM_PROMPT=""

NODE_ENV="development"

AUTUMN_SECRET_KEY=

# IMAP/SMTP connections
# Set to "true" to let users add IMAP/SMTP mailboxes.
IMAP_ENABLED=
# AES-256-GCM keys for stored mail credentials, as `version:base64Key` pairs (comma-separated
# for rotation; the highest version encrypts). Generate one with: echo "1:$(openssl rand -base64 32)"
CREDENTIALS_ENCRYPTION_KEYS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# FOR PLAYWRIGHT E2E TESTING
PLAYWRIGHT_SESSION_TOKEN = 
PLAYWRIGHT_SESSION_DATA =
EMAIL =

# Optional Keiki conversation assistant. Leave credentials blank to disable it; do not enable without reviewing its pricing and data handling.
KEIKI_API_KEY=
KEIKI_AGENT_ID=
KEIKI_PLATFORM_URL=https://onkeiki.com
# Optional public callback origin for local development, e.g. a dev tunnel.
KEIKI_CALLBACK_URL=
KEIKI_WEBHOOK_SECRET=
KEIKI_MODEL=openrouter/free
KEIKI_PHOTON_LINE=

# App cards are delivered by Keiki on dedicated lines purchased through Keiki.
# Zero requires no Photon project credentials. Other lines use the review URL.
